# Claude evaluation. Without it, only price rules run.
ANTHROPIC_API_KEY=
# Optional: cheaper model for the daily run, e.g. claude-haiku-4-5 (default claude-opus-5-5).
ANTHROPIC_MODEL=
# Only needed when the key was created at organisation level rather than inside a workspace
ANTHROPIC_WORKSPACE_ID=

# Market data: free (default; keyless Yahoo quotes + Google News), mock, or kite.
MARKET_PROVIDER=

# Supabase (Project settings > API). Without these, data is kept in .data/db.json (local only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects the cron endpoint. Vercel sends it automatically when set in project env.
CRON_SECRET=

# Zerodha Kite Connect (read-only use). Without these, quotes and holdings are simulated.
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Free testing with any OpenAI-compatible endpoint (Ollama, Groq, OpenRouter). When LLM_BASE_URL
# and LLM_MODEL are set they replace Anthropic; remove them to switch back.
#   local Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2
#   ollama.com:    LLM_BASE_URL=https://ollama.com/v1       LLM_MODEL=gpt-oss:20b  LLM_API_KEY=<key>
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
